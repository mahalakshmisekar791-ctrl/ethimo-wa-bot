# ============================================================
#  ETHIMO Technology — WhatsApp Bot Environment Variables
#  Copy this file to .env and fill in your actual values
# ============================================================

# ── WhatsApp Cloud API (from Meta Developer Console) ────────
WA_TOKEN=your_permanent_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=ethimo_secure_webhook_2024

# ── Google Sheets (from Google Cloud Console) ───────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
# (The credentials.json file handles authentication)

# ── Email Notifications (Gmail) ─────────────────────────────
ADMIN_EMAIL=admin@ethimotechnology.com
EMAIL_USER=ethimopvtltd@gmail.com
EMAIL_PASS=your_gmail_app_password_here
# Note: Use Gmail App Password, not your regular password
# Get it at: myaccount.google.com/apppasswords

# ── Server ───────────────────────────────────────────────────
PORT=3000
